# App Settings
PROJECT_NAME="AWS Route 53 Mini Clone"
ENVIRONMENT="development" # Set to "production" in production deployments
SECRET_KEY="supersecretkey-change-in-production-use-random-bytes"

# CORS Configuration
# Comma-separated origins or JSON array. In production on Render, include your frontend domain:
# e.g. CORS_ORIGINS="http://localhost:3000,https://aws-route-53-mini-clone.vercel.app"
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
# CORS_ORIGIN_REGEX="https://.*\.vercel\.app"

# Database
DATABASE_URL="sqlite:///./route53.db"

# Mock Auth Credentials
MOCK_USER_USERNAME="admin"
MOCK_USER_PASSWORD="adminpassword123"
MOCK_USER_EMAIL="admin@example.com"
SESSION_COOKIE_NAME="route53_session"
SESSION_EXPIRE_HOURS=24

# Cookie Settings (optional, automatically configured based on ENVIRONMENT)
# In production with cross-origin frontend (e.g. Render backend + Vercel frontend),
# COOKIE_SAMESITE="none" and COOKIE_SECURE="true" are automatically set when ENVIRONMENT="production".
# COOKIE_SAMESITE="none"
# COOKIE_SECURE=true

